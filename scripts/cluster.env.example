# Copy to scripts/cluster.env (git-ignored) and fill in for your cluster. Sourced by start/stop/deploy.
# Rank 0 is the host that runs start_tensorfold.sh (it serves the API). Workers are reached over SSH by fabric address.
WORKERS=(user1@10.0.0.2 user2@10.0.0.3 user3@10.0.0.4)   # ranks 1..3, in order
MASTER_IP=10.0.0.1                                      # rank 0's fabric address (NCCL rendezvous)
MASTER_PORT=29688
ROOT=/var/tmp/ernie55                                   # same path on every rank: bin/, lib/, logs/
MODEL_DIR=/var/tmp/models/ERNIE-5.5-Flash-Preview       # visible at this path on every rank (NFS is fine)
PORT=8888
SERVED_NAME=ernie-5.5-flash-preview
CONTEXT=262144
# RoCE / NCCL (names from `ibv_devices` and `ip link`; GID index from `show_gids`)
NET_IFACE=enp1s0f1np1
HCAS=rocep1s0f1,roceP2p1s0f1
GID_INDEX=3
IB_TC=106
